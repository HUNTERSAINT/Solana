# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL. The application creates its own tables on startup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solana_screener
PGSSL=false

# Telegram. Leave blank to run the HTTP screener without a bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Data sources
DEXSCREENER_API_URL=https://api.dexscreener.com
RUGCHECK_API_URL=https://api.rugcheck.xyz
RUGCHECK_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Discovery and scoring
POLL_INTERVAL_SECONDS=60
DEX_SEARCH_TERMS=SOL,USDC,USDT,WIF,BONK,MEME
MIN_LIQUIDITY_USD=10000
MAX_HOLDER_CONCENTRATION_PERCENT=35
MAX_VOLUME_LIQUIDITY_RATIO=20
ALERT_MIN_SCORE=60
ALERT_ON_UNKNOWN=false